<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 前台服务保活（Android 8+/14+ 必需） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 息屏播报期间防止 CPU 休眠 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Android 13+ 通知权限（运行时向用户申请） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 精确闹钟（可选；无权限时自动退化为系统“闹钟”类型） -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 开机自启：重启手机后自动恢复提醒服务 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 引导用户加入电池优化白名单（跳转系统设置页时使用） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Android 10+：息屏到点自动亮屏并拉起 App（全屏提醒） -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <application>
        <service
            android:name="uts.sdk.modules.smartReminderKeepalive.SmartReminderService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <meta-data
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="语音提醒持续播报服务" />
        </service>
        <receiver
            android:name="uts.sdk.modules.smartReminderKeepalive.ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="uts.sdk.modules.smartReminderKeepalive.FIRE" />
                <action android:name="uts.sdk.modules.smartReminderKeepalive.RESTART" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="uts.sdk.modules.smartReminderKeepalive.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
